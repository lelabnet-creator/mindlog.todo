# Dev local. 10.0.2.2 = l'hôte vu depuis l'émulateur Android (sur un téléphone
# physique, remplacer par l'IP LAN du poste).
#
# ATTENTION : cette cible est en HTTP clair. Android bloque le cleartext par
# défaut — il faut ajouter `android:usesCleartextTraffic="true"` au <application>
# de android/app/src/main/AndroidManifest.xml pour un build de dev, et NE PAS
# le laisser dans un build de release.
VITE_API_URL=http://10.0.2.2:8080
